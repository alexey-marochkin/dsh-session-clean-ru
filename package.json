{
  "name": "dsh-session-clean-ru",
  "version": "1.6.6-ru.1",
  "private": true,
  "description": "Удаление чатов с подтверждением и проверка ссылок на их вложения в DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "author": {
    "name": "Ansellwan",
    "url": "https://github.com/Ansellwan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansellwan/DeepSeekHarness-Session-Delete.git"
  },
  "homepage": "https://github.com/Ansellwan/DeepSeekHarness-Session-Delete#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-management"
  ],
  "scripts": {
    "test": "node tools/check-declaration.mjs && node tools/smoke-host.mjs && node --test tools/fork.test.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
    "index.js",
    "agent-tool.js",
    "attachments.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/*.png",
    "docs/Предложение по API выгрузки чатов.md",
    "LICENSE"
  ],
  "meta": {
    "title": "Удаление чатов",
    "description": "Удаление чатов из меню или по точному названию через агента, с подтверждением. Вложения проверяются, но не удаляются."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
